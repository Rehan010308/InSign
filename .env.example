# InSign environment — copy to .env.local and fill in.
# Both values are PUBLIC: they ship inside the browser bundle.

# Project URL, e.g. https://abcdefghijklm.supabase.co
# Supabase dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# The PUBLIC anon key only. Never the service-role key — it would be readable
# by anyone who opens the site. The app refuses to start with a service_role key.
# Supabase dashboard → Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=

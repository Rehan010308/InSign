# Playwright runs against the labelled local demo store, not a real project.
#
# The end-to-end suite creates accounts, seeds session history and asserts on
# what is stored; pointing that at a live Supabase project would need email
# confirmation, would leave test rows behind, and would make the results depend
# on the network. Blanking these two values puts the app in local demo mode for
# `vite --mode test` only — `.env.local` still wins everywhere else.
#
# No secret belongs in this file: both values are deliberately empty.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
